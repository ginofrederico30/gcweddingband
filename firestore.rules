rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin()       { return request.auth != null && request.auth.token.email == 'gino@gcweddingband.com'; }
    function isArtist()      { return request.auth != null && request.auth.token.email == 'artist@gcweddingband.com'; }
    function isOwner(id)     { return request.auth != null && request.auth.uid == id; }

    // Band member with their own login: active, and has replaced their temporary password
    function memberPath()    { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function isMember()      { return request.auth != null && exists(memberPath())
                                 && get(memberPath()).data.active == true
                                 && get(memberPath()).data.mustChangePassword == false; }
    // Anyone who can use the Artist Portal: the shared guest login or a member
    function isBand()        { return isArtist() || isMember(); }

    match /config/{doc} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }
    match /clients/{id} {
      allow read:  if isAdmin() || isBand() || isOwner(id);
      allow write: if isAdmin();
    }
    function validSignedAt() {
      return request.resource.data.get('signedAt', null) == null
          || request.resource.data.signedAt is int;
    }

    match /contracts/{id} {
      allow read:   if isAdmin() || isBand() || isOwner(id);
      allow write:  if isAdmin();

      // Client, before signing: only the client section + signature fields
      allow update: if isOwner(id)
                    && resource.data.get('signedAt', null) == null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['client', 'signedAt', 'signatureData'])
                    && validSignedAt();

      // Client may create a contract doc only with an empty admin section
      allow create: if isOwner(id)
                    && request.resource.data.keys().hasOnly(['admin', 'client', 'signedAt', 'signatureData'])
                    && request.resource.data.get('admin', {}) == {}
                    && validSignedAt();
    }
    match /gcp/{id} {
      allow read:  if isAdmin() || isBand() || isOwner(id);
      allow write: if isAdmin() || isOwner(id)
                   || (isBand() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vendorMeals']));
    }
    match /setlists/{id} {
      allow read:  if isAdmin() || isBand() || isOwner(id);
      allow write: if isAdmin() || isBand();
    }

    // Band member accounts (login lives in Firebase Auth; this holds the profile + flags)
    match /members/{uid} {
      allow read:   if isAdmin() || isOwner(uid);
      allow write:  if isAdmin();

      // Member clears their own must-change flag after setting a new password
      allow update: if isOwner(uid)
                    && resource.data.active == true
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt'])
                    && request.resource.data.mustChangePassword == false
                    && request.resource.data.updatedAt == request.time;
    }

    // Payouts, one doc per member per gig (gigId = client id). Members read only their own.
    match /payouts/{uid}/gigs/{gigId} {
      allow read:  if isAdmin() || (isOwner(uid) && isMember());
      allow write: if isAdmin();
    }
  }
}
